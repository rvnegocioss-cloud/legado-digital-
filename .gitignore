# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# servers (MCP local, não subir)
/servers

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.playwright-mcp/
.worktrees/

# ortomosaico: binarios/saidas geradas, arquivos grandes nao vao pro repo
scripts/ortomosaico/bin/
scripts/ortomosaico/*.mbtiles
scripts/ortomosaico/*.pmtiles
scripts/ortomosaico/__pycache__/

# graphify: grafo local, regenerado a cada extract/update
graphify-out/

# Trava de segurança: chave de conta de serviço do Google nunca pode ser
# rastreada, mesmo que alguém salve/arraste ela pra dentro da pasta do
# projeto por engano. As chaves reais ficam fora do repo, em
# Desktop\Cerebro Claude - Legado Digital\credenciais\ (não é git).
*service-account*.json
google-credentials*.json

# worker do maplibre-gl, copiado de node_modules a cada build
/public/maplibre/
